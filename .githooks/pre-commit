#!/usr/bin/env sh

bun test || exit 1

# lldtdd is a real devDependency now: installed by `bun install` and resolved from
# node_modules, which retires the old concern this block used to document -- the
# lint no longer runs an out-of-repo path, it runs the lockfile-pinned package in
# this repo. Not installed yet (fresh clone before bun install): skip rather than
# block the commit on it.
changedLLDs=$(git diff --name-only --cached | grep -c "\.lld\.md$")
if [ "$changedLLDs" -gt 0 ]; then
	if [ -x "node_modules/.bin/lldtdd" ]; then
		bun run lldtdd lint || exit 1
	else
		echo "lldtdd not installed -- run bun install (staged .lld.md changes not checked)"
	fi
fi
